# =============================================================================
#  mmkb — 通用多模态知识库问答系统   环境变量样例
#  用法：  copy .env.example .env      （Windows / PowerShell）
#          cp   .env.example .env      （macOS / Linux）
#  然后填写所有标了【必填】的项。
#
#  标记说明：
#    【必填】    不填则 GET /api/health 返回 not_ready，业务接口返回 503
#    【有默认】  可整行删除，代码内有默认值
#    【可留空】  留空 = 关闭该功能，或自动继承上游（见该行注释）
#
#  优先级：真实环境变量 > .env.local > .env > 代码内默认值
#  ⚠️ .env 里出现但本文件未列出的变量会被忽略（config.py 设了 extra="ignore"）
# =============================================================================


# -----------------------------------------------------------------------------
#  1. 应用进程
# -----------------------------------------------------------------------------
APP_ENV=dev                      # 【有默认】dev | prod。prod 会打开更严格的错误响应
APP_LOG_LEVEL=INFO               # 【有默认】DEBUG | INFO | WARNING | ERROR
APP_LOG_JSON=false               # 【有默认】false=人类可读单行日志；容器/生产建议 true
APP_HOST=0.0.0.0                 # 【有默认】
APP_PORT=8000                    # 【有默认】
APP_CORS_ORIGINS=*               # 【有默认】逗号分隔；* 表示全部放行。生产请写具体来源
APP_STATIC_URL_PREFIX=/static    # 【有默认】图片对外暴露的 URL 前缀
APP_API_PREFIX=/api              # 【有默认】


# -----------------------------------------------------------------------------
#  2. 生成模型 LLM  （DeepSeek，OpenAI 兼容 SDK）
#     deepseek-flash 原生支持图像输入 + 思考模式 + 1M 上下文 + 流式输出
#     不支持视频输入，本项目不实现视频链路
# -----------------------------------------------------------------------------
LLM_PROVIDER=deepseek                         # 【有默认】目前仅 deepseek
LLM_API_KEY=                                  # 【必填】DeepSeek 控制台 → https://platform.deepseek.com
LLM_BASE_URL=https://api.deepseek.com         # 【有默认】
LLM_MODEL=deepseek-flash                      # 【有默认】
LLM_TEMPERATURE=0.3                           # 【有默认】RAG 场景建议 0.2~0.4
LLM_MAX_TOKENS=4096                           # 【有默认】单次生成上限
LLM_TIMEOUT_S=120                             # 【有默认】非流式请求超时（秒）
LLM_STREAM_TIMEOUT_S=600                      # 【有默认】流式请求总超时（秒）
LLM_MAX_RETRIES=3                             # 【有默认】tenacity 指数退避重试次数
LLM_MAX_CONCURRENCY=4                         # 【有默认】进程内并发上限（信号量）
LLM_RPM_LIMIT=0                               # 【有默认】每分钟请求上限，0 = 不限流

# 思考模式（reasoning）。默认 high，即默认开启。
# 取值：low | high | max | none      none = 关闭思考（Anthropic 格式下用 none 关闭）
LLM_REASONING_EFFORT=high                     # 【有默认】none = 不发该参数 = 关闭思考
# 是否把 reasoning_effort 发出去。若某个兼容网关不认这个参数，设 false 整体关闭
LLM_SEND_REASONING_EFFORT=true                # 【有默认】


# -----------------------------------------------------------------------------
#  3. 视觉模型 Vision  （图片 caption 生成，走 LLM 的视觉能力）
#     所有项留空即继承第 2 节的 LLM_*，通常整节都不用改
# -----------------------------------------------------------------------------
VISION_ENABLED=true              # 【有默认】false = 关闭 VLM caption，图片改用「前后文文本」合成描述（降级）
VISION_PROVIDER=deepseek         # 【有默认】
VISION_API_KEY=                  # 【可留空】留空 → 继承 LLM_API_KEY
VISION_BASE_URL=                 # 【可留空】留空 → 继承 LLM_BASE_URL
VISION_MODEL=                    # 【可留空】留空 → 继承 LLM_MODEL（deepseek-flash）
VISION_TEMPERATURE=0.1           # 【有默认】结构化 JSON 输出，温度要低
VISION_MAX_TOKENS=1500           # 【有默认】caption JSON 长度上限
VISION_TIMEOUT_S=120             # 【有默认】
VISION_MAX_RETRIES=3             # 【有默认】
VISION_MAX_CONCURRENCY=4         # 【有默认】caption 并发生成数，是导入耗时的主要旋钮
VISION_MAX_IMAGE_SIDE=1600       # 【有默认】送模型前等比缩放到最长边不超过该值（省 token）
VISION_JPEG_QUALITY=85           # 【有默认】缩放后重新编码的质量
VISION_REASONING_EFFORT=low      # 【有默认】low | high | max | none。caption 用 low 足够且更快


# -----------------------------------------------------------------------------
#  4. 文本向量 Embedding
#     ⚠️ DeepSeek 官方 API 没有 embedding 端点（调用会 404），必须外挂本节的 provider
# -----------------------------------------------------------------------------
TEXT_EMBED_ENABLED=true          # 【有默认】false = 关闭文本向量召回（只剩 BM25 路）
TEXT_EMBED_PROVIDER=dashscope    # 【有默认】dashscope | siliconflow
TEXT_EMBED_API_KEY=              # 【必填】阿里云百炼控制台 → https://bailian.console.aliyun.com
                                 #   注意：该 Key 必须允许访问 TEXT_EMBED_MODEL。若报 AccessDenied /
                                 #   "Access denied by API-Key restrictions."，是 Key 的「模型限制」没放开，
                                 #   与请求参数无关。可与 IMAGE_EMBED_API_KEY 用同一把 Key。
TEXT_EMBED_BASE_URL=             # 【可留空】留空 → dashscope: .../compatible-mode/v1 ; siliconflow: https://api.siliconflow.cn/v1
TEXT_EMBED_MODEL=                # 【可留空】留空 → dashscope: text-embedding-v4 ; siliconflow: BAAI/bge-m3
TEXT_EMBED_DIM=1024              # 【有默认】必须落在 TEXT_EMBED_ALLOWED_DIMS 里，且要与模型实际返回一致
TEXT_EMBED_ALLOWED_DIMS=2048,1536,1024,768,512,256   # 【有默认】合法档位白名单，改档位时同步改这里
TEXT_EMBED_BATCH_SIZE=10         # 【有默认】单次请求条数上限，超出的自动分片
TEXT_EMBED_MAX_CONCURRENCY=3     # 【有默认】
TEXT_EMBED_TIMEOUT_S=60          # 【有默认】
TEXT_EMBED_MAX_RETRIES=3         # 【有默认】
TEXT_EMBED_RPM_LIMIT=0           # 【有默认】0 = 不限流
TEXT_EMBED_NORMALIZE=true        # 【有默认】向量 L2 归一化后再入库
TEXT_EMBED_TRUNCATE_CHARS=6000   # 【有默认】单条文本超长截断（字符数）


# -----------------------------------------------------------------------------
#  5. 多模态向量 Embedding（图像）
#     ⚠️ 必须调用 DashScope 原生 API，OpenAI 兼容模式【不支持】多模态 embedding
#     ⚠️ 查询时必须使用同一个 model + 同一个 enable_fusion，才能与图片落在同一融合空间
# -----------------------------------------------------------------------------
IMAGE_EMBED_ENABLED=true                      # 【有默认】false = 关闭图像向量（以文搜图/以图搜图失效）
IMAGE_EMBED_PROVIDER=dashscope                # 【有默认】目前仅 dashscope
IMAGE_EMBED_API_KEY=                          # 【必填】与 TEXT_EMBED_API_KEY 可以是同一把 DashScope Key
IMAGE_EMBED_BASE_URL=https://dashscope.aliyuncs.com   # 【有默认】原生 API 域名，注意不是 compatible-mode
IMAGE_EMBED_PATH=/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding  # 【有默认】原生端点路径
IMAGE_EMBED_MODEL=qwen3-vl-embedding          # 【有默认】
IMAGE_EMBED_DIM=2560                          # 【有默认】必须落在 IMAGE_EMBED_ALLOWED_DIMS 里
IMAGE_EMBED_ALLOWED_DIMS=2560,2048,1536,1024,768,512,256   # 【有默认】
IMAGE_EMBED_ENABLE_FUSION=true                # 【有默认】图文融合空间开关。入库与查询必须完全一致，否则向量不可比
# ⚠️ enable_fusion=true 时端点会把整批 contents 融合成 1 个向量，必须逐条请求；
#    只有 enable_fusion=false 才能大于 1。配大了 provider 会自动按 1 发送并打警告。
IMAGE_EMBED_BATCH_SIZE=1
IMAGE_EMBED_MAX_CONCURRENCY=2                 # 【有默认】
IMAGE_EMBED_TIMEOUT_S=120                     # 【有默认】
IMAGE_EMBED_MAX_RETRIES=3                     # 【有默认】
IMAGE_EMBED_RPM_LIMIT=0                       # 【有默认】0 = 不限流
IMAGE_EMBED_MAX_IMAGE_SIDE=1568               # 【有默认】送 embedding 前等比缩放最长边
IMAGE_EMBED_NORMALIZE=true                    # 【有默认】


# -----------------------------------------------------------------------------
#  6. 重排 Rerank
#     ⚠️ 已知限制：reranker 只接受纯文本，无法理解图像。
#        图片类候选一律用「caption + 章节路径」拼成的文本参与重排（见 9.15 的模板）
# -----------------------------------------------------------------------------
RERANK_ENABLED=true              # 【有默认】false = 关闭重排，只用 RRF 分数排序
RERANK_PROVIDER=dashscope        # 【有默认】dashscope | siliconflow
RERANK_API_KEY=                  # 【必填】RERANK_ENABLED=false 时可留空
RERANK_BASE_URL=                 # 【可留空】留空 → dashscope: https://dashscope.aliyuncs.com ; siliconflow: https://api.siliconflow.cn/v1
RERANK_PATH=                     # 【可留空】留空 → dashscope: /api/v1/services/rerank/text-rerank/text-rerank ; siliconflow: /rerank
RERANK_MODEL=                    # 【可留空】留空 → dashscope: gte-rerank-v2 ; siliconflow: BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_S=60              # 【有默认】
RERANK_MAX_RETRIES=3             # 【有默认】
RERANK_MAX_DOCS_PER_REQUEST=50   # 【有默认】单次送入重排的候选文档数上限
RERANK_MAX_CHARS_PER_DOC=4000    # 【有默认】单文档超长截断，避免请求体过大
RERANK_RPM_LIMIT=0               # 【有默认】0 = 不限流
# 图片候选参与重排时的文本模板（reranker 吃不了图像，只能喂文本）
RERANK_IMAGE_DOC_TEMPLATE=[图片] {heading} | {caption}   # 【有默认】可用占位符：{heading} {caption} {ocr} {keywords}


# -----------------------------------------------------------------------------
#  7. 向量库
# -----------------------------------------------------------------------------
VECTORSTORE_BACKEND=chroma       # 【有默认】chroma | pg（pg 需先 pip install -e ".[pg]"）
VECTORSTORE_CHROMA_DIR=          # 【可留空】留空 → <DATA_DIR>/chroma
VECTORSTORE_METRIC=cosine        # 【有默认】cosine | l2 | ip ；两个后端共用这一个度量
VECTORSTORE_CHROMA_SPACE=        # 【可留空】旧名字，留空即用 VECTORSTORE_METRIC；填了以它为准
VECTORSTORE_PG_DSN=              # 【可留空】postgresql://user:pwd@host:5432/db ；backend=pg 时【必填】
VECTORSTORE_PG_TABLE_PREFIX=mmkb # 【有默认】
VECTORSTORE_PG_POOL_SIZE=5       # 【有默认】


# -----------------------------------------------------------------------------
#  8. 元数据存储（SQLite）
# -----------------------------------------------------------------------------
DOCSTORE_SQLITE_PATH=            # 【可留空】留空 → <DATA_DIR>/mmkb.db
DOCSTORE_ECHO_SQL=false          # 【有默认】true = 打印所有 SQL，调试用


# -----------------------------------------------------------------------------
#  9. 图片处理链路
# -----------------------------------------------------------------------------
BLOB_IMAGES_DIR=                 # 【可留空】留空 → <DATA_DIR>/images
BLOB_MIN_WIDTH=100               # 【有默认】小于该宽度的图直接丢弃（图标/装饰线）
BLOB_MIN_HEIGHT=100              # 【有默认】
BLOB_PHASH_SIZE=8                # 【有默认】感知哈希边长，8 → 64 位指纹
BLOB_PHASH_HAMMING_THRESHOLD=5   # 【有默认】汉明距离 ≤ 该值判为重复图
BLOB_BLANK_STD_THRESHOLD=6.0     # 【有默认】灰度标准差低于该值判为纯色/极低信息量图
BLOB_MIN_UNIQUE_COLOR_RATIO=0.01 # 【有默认】唯一颜色占比低于该值判为低信息量图
BLOB_DEDUPE_SCOPE=kb             # 【有默认】doc = 仅文档内去重；kb = 整个知识库内去重
BLOB_MAX_IMAGES_PER_DOC=0        # 【有默认】单文档最多保留图片数，0 = 不限
BLOB_CONVERT_TO_PNG=false        # 【有默认】true = 统一转 PNG（体积变大，但格式统一）
BLOB_JPEG_QUALITY=90             # 【有默认】


# -----------------------------------------------------------------------------
# 10. 文本切分
# -----------------------------------------------------------------------------
CHUNK_MIN_TOKENS=300             # 【有默认】合并目标下限
CHUNK_MAX_TOKENS=800             # 【有默认】单块上限
CHUNK_OVERLAP_TOKENS=100         # 【有默认】相邻块重叠 token 数
CHUNK_ENCODING=cl100k_base       # 【有默认】tiktoken 编码名，用于 token 计数
CHUNK_TABLE_MAX_TOKENS=1500      # 【有默认】表格块允许超过 CHUNK_MAX_TOKENS，但仍设硬上限
CHUNK_TABLE_REPEAT_HEADER=true   # 【有默认】超长表格切片时每片重复表头
CHUNK_KEEP_CODE_ATOMIC=true      # 【有默认】代码块绝不在中间切断
CHUNK_KEEP_TABLE_ATOMIC=true     # 【有默认】表格绝不从中间切断
CHUNK_MERGE_SMALL_SIBLINGS=true  # 【有默认】同标题下的过短块向上合并
CHUNK_MIN_CHUNK_CHARS=20         # 【有默认】短于该字符数的块直接丢弃


# -----------------------------------------------------------------------------
# 11. 检索与融合
#     下面三个 ENABLE_* 同时就是 A/B 消融的开关（见 app/eval/ablation.py）
# -----------------------------------------------------------------------------
RETRIEVAL_ENABLE_BM25=true       # 【有默认】第 1 路：稀疏检索
RETRIEVAL_ENABLE_DENSE_TEXT=true # 【有默认】第 2 路：文本向量
RETRIEVAL_ENABLE_DENSE_IMAGE=true # 【有默认】第 3 路：多模态向量（以文搜图）
RETRIEVAL_ENABLE_RERANK=true     # 【有默认】融合后是否重排
RETRIEVAL_TOP_K_PER_ROUTE=20     # 【有默认】每路各自召回的条数
RETRIEVAL_RRF_K=60               # 【有默认】RRF 公式 score = Σ 1/(k + rank)
RETRIEVAL_ROUTE_WEIGHTS=1.0,1.0,1.0   # 【有默认】三路权重，顺序固定为 bm25, dense_text, dense_image
RETRIEVAL_RERANK_INPUT_K=50      # 【有默认】送入 reranker 的候选数
RETRIEVAL_FINAL_TOP_K=8          # 【有默认】最终进入 context 的条数
RETRIEVAL_MIN_SCORE_AFTER_RERANK=0.0  # 【有默认】低于该分数直接丢弃
RETRIEVAL_NEIGHBOR_EXPAND=0      # 【有默认】命中块是否额外带前后邻居（0/1/2/3）
RETRIEVAL_CONTEXT_MAX_CHARS=12000 # 【有默认】拼给 LLM 的 context 总字符上限
RETRIEVAL_IMAGE_QUERY_TOP_K=10   # 【有默认】以图搜图接口返回条数


# -----------------------------------------------------------------------------
# 12. BM25 稀疏检索
# -----------------------------------------------------------------------------
BM25_TOKENIZER=auto              # 【有默认】auto = 中文走 jieba、英文走正则小写；也可强制 jieba | regex
BM25_K1=1.5                      # 【有默认】词频饱和参数
BM25_B=0.75                      # 【有默认】长度归一化参数
BM25_INDEX_DIR=                  # 【可留空】留空 → <DATA_DIR>/processed/bm25
BM25_PERSIST=true                # 【有默认】true = 索引落盘，重启免重建
BM25_STOPWORDS=                  # 【可留空】逗号分隔的自定义停用词；留空 = 只用内置英文停用词
BM25_MIN_TOKEN_LEN=1             # 【有默认】短于该长度的 token 丢弃


# -----------------------------------------------------------------------------
# 13. Agent 主循环
# -----------------------------------------------------------------------------
AGENT_MAX_ROUNDS=2               # 【有默认】最多检索轮数
AGENT_RELEVANCE_THRESHOLD=0.6    # 【有默认】LLM 相关性打分低于该值则改写问题重检（0~1）
AGENT_JUDGE_ENABLED=true         # 【有默认】false = 跳过相关性打分，直接进生成
AGENT_JUDGE_MAX_CONTEXT_ITEMS=8  # 【有默认】送入打分的候选条数
AGENT_QUERY_REWRITE_ENABLED=true # 【有默认】多查询改写（LLM 生成 N 个角度）
AGENT_QUERY_REWRITE_N=3          # 【有默认】
AGENT_ROUTER_LLM_ENABLED=true    # 【有默认】false = 只用关键词规则路由，省一次 LLM 调用
AGENT_SMALLTALK_SKIP_RETRIEVAL=true   # 【有默认】寒暄类问题不走向量检索
AGENT_HISTORY_MAX_TURNS=6        # 【有默认】带入的多轮历史轮数
AGENT_HISTORY_COMPRESS_ENABLED=true   # 【有默认】历史过长时先压缩成独立可检索 query
AGENT_HISTORY_COMPRESS_TRIGGER_CHARS=2000   # 【有默认】超过该字符数触发压缩


# -----------------------------------------------------------------------------
# 14. 答案生成
# -----------------------------------------------------------------------------
GEN_TEMPERATURE=0.2              # 【有默认】
GEN_MAX_TOKENS=4096              # 【有默认】
GEN_REQUIRE_CITATIONS=true       # 【有默认】强制每个关键结论带 [n] 引用标记
GEN_REFUSE_WHEN_EMPTY=true       # 【有默认】context 无依据时必须回「知识库中未找到相关内容」
GEN_ALLOW_MODEL_KNOWLEDGE=true   # 【有默认】允许用模型自身知识补充，但必须显式标注「以下不属于知识库内容」
GEN_MAX_CITATIONS=8              # 【有默认】
GEN_SNIPPET_CHARS=300            # 【有默认】引用片段截断长度
GEN_STREAM_HEARTBEAT_S=15        # 【有默认】SSE 心跳间隔（秒），防止网关掐断长连接


# -----------------------------------------------------------------------------
# 15. 文档导入
# -----------------------------------------------------------------------------
INGEST_MAX_FILE_MB=200           # 【有默认】单文件大小上限
INGEST_MAX_CONCURRENT_DOCS=1     # 【有默认】同时处理的文档数
INGEST_IMAGE_INSPECT_CONCURRENCY=4   # 【有默认】单篇文档内图片检查（解码/phash/模糊判定）并发度
INGEST_KEEP_UPLOADED_FILE=true   # 【有默认】导入后保留上传的原始文件
INGEST_UPLOAD_DIR=               # 【可留空】留空 → <DATA_DIR>/raw


# -----------------------------------------------------------------------------
# 16. 评估
# -----------------------------------------------------------------------------
EVAL_DATASET_PATH=               # 【可留空】留空 → <DATA_DIR>/eval/eval_set.jsonl
EVAL_OUTPUT_DIR=                 # 【可留空】留空 → <DATA_DIR>/eval
EVAL_RECALL_KS=5,10              # 【有默认】要计算的 Recall@k
EVAL_MRR_K=10                    # 【有默认】
EVAL_NDCG_K=10                   # 【有默认】
EVAL_USE_RAGAS=false             # 【有默认】true 需先 pip install -e ".[eval]"；不可用则自动降级为自实现指标
EVAL_RAGAS_METRICS=faithfulness,answer_relevancy,context_precision   # 【有默认】
EVAL_MAX_QUESTIONS=0             # 【有默认】0 = 跑全部题目，调试时可设小值
EVAL_JUDGE_MODEL=                # 【可留空】留空 → 继承 LLM_MODEL
EVAL_ABLATION_PRESETS=bm25_only,dense_text_only,dense_image_only,hybrid_rrf,hybrid_rrf_rerank   # 【有默认】五组消融


# -----------------------------------------------------------------------------
# 17. 路径（通常只需改 DATA_DIR，其余留空自动派生）
# -----------------------------------------------------------------------------
DATA_DIR=./data                  # 【有默认】单库数据根目录；Docker 里是 /app/data
RAW_ROOT=                        # 【可留空】留空 → <DATA_DIR>/raw
PROCESSED_ROOT=                  # 【可留空】留空 → <DATA_DIR>/processed
IMAGES_ROOT=                     # 【可留空】留空 → <DATA_DIR>/images
CHROMA_ROOT=                     # 【可留空】留空 → <DATA_DIR>/chroma
EVAL_ROOT=                       # 【可留空】留空 → <DATA_DIR>/eval
BM25_ROOT=                       # 【可留空】留空 → <DATA_DIR>/processed/bm25
LOGS_ROOT=                       # 【可留空】留空 → <DATA_DIR>/logs
SQLITE_FILE=                     # 【可留空】留空 → <DATA_DIR>/mmkb.db


# -----------------------------------------------------------------------------
# 18. 进程内缓存（检索链路加速；关闭后语义与未加缓存完全一致）
# -----------------------------------------------------------------------------
CACHE_ENABLED=true               # 【有默认】总开关
CACHE_QUERY_EMBEDDING_TTL_S=600  # 【有默认】query 向量缓存 TTL（秒）
CACHE_QUERY_EMBEDDING_MAX_ENTRIES=512   # 【有默认】query 向量缓存条数上限
CACHE_RERANK_TTL_S=300           # 【有默认】重排分数缓存 TTL（秒）
CACHE_RERANK_MAX_ENTRIES=256     # 【有默认】重排缓存条数上限
CACHE_COLLECTION_META_TTL_S=30   # 【有默认】Chroma collection 元信息缓存 TTL（秒）；写入时主动失效
